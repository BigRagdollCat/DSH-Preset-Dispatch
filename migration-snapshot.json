      "isDefault": false
    },
    {
      "id": "researcher",
      "name": "研究检索",
      "description": "只读定位文件、符号、依赖与官方版本资料；不作代码验收。",
      "order": 21,
      "isDefault": false
    },
    {
      "id": "investigator",
      "name": "根因调查",
      "description": "只读分析症状、触发条件、根因、生命周期与跨模块因果链。",
      "order": 22,
      "isDefault": false
    },
    {
      "id": "reviewer",
      "name": "代码审查",
      "description": "对冻结候选进行独立只读审查，关注真实缺陷、授权与回归风险。",
      "order": 23,
      "isDefault": false
    },
    {
      "id": "implementer",
      "name": "实现开发",
      "description": "在明确授权范围内修改生产代码；单写者，不承担独立测试验收。",
      "order": 24,
      "isDefault": false
    },
    {
      "id": "test-author",
      "name": "测试编写",
      "description": "仅编写测试与夹具；不修改生产代码、不运行测试。",
      "order": 25,
      "isDefault": false
    },
    {
      "id": "verifier",
      "name": "测试验证",
