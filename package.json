  "files": ["entry.js", "managed-presets.js", "management-api.js", "catalog.js", "catalog-cache.js", "role-managed.js", "history.js", "history-store.js", "dispatch-observation.js", "visibility-api.js", "query-compaction.js", "query-compaction-host.js", "roles-configured.js", "roles-active.js", "roles-final.js", "roles-live.js", "roles-entry.js", "role-plugin.js", "roles.js", "routing.js", "settings-final.js", "host.js", "index.js", "core.js", "policy.js", "save-protocol.js", "settings-api.js", "client.js", "cordis.patch.yml", "README.md", "MAINTENANCE.md", "LICENSE", "screenshots.json", "docs", "scripts", "test"],
  "scripts": { "test": "node scripts/test.mjs", "test:spawn": "node --test test/*.test.js", "check": "node scripts/check.mjs", "pack": "node scripts/pack-check.mjs", "storage": "node scripts/storage-contract-check.mjs", "verify": "node scripts/check.mjs && node scripts/test.mjs && node scripts/pack-check.mjs && node scripts/storage-contract-check.mjs" },
